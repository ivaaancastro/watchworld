# Variables de entorno requeridas para WatchWorld
# Copia este archivo como .env.local y rellena los valores

# ─────────────────────────────────────────────────
# BASE DE DATOS (Neon PostgreSQL)
# https://neon.tech → crea un proyecto → copia la connection string
# ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/watchworld?sslmode=require

# ─────────────────────────────────────────────────
# AUTH (NextAuth.js v5 / Auth.js)
# AUTH_SECRET: genera con → openssl rand -base64 32
# Google OAuth: https://console.cloud.google.com → APIs → Credentials
# ─────────────────────────────────────────────────
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─────────────────────────────────────────────────
# MEILISEARCH
# Local: docker run -d -p 7700:7700 getmeili/meilisearch:latest
# ─────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# ─────────────────────────────────────────────────
# CLOUDINARY (imágenes)
# https://cloudinary.com → Dashboard
# ─────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────
# UPSTASH REDIS (cache)
# https://upstash.com → crea una DB Redis → copia credenciales
# ─────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────
# OPENAI (IA - Fase 3)
# https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────
OPENAI_API_KEY=

# ─────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
