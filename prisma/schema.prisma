// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────
// BRANDS & MODELS
// ─────────────────────────────────────────────────

model Brand {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  country     String        @default("Switzerland")
  foundedYear Int?
  description Json?         // { es: "...", en: "..." }
  logoUrl     String?
  websiteUrl  String?
  isFeatured  Boolean       @default(false)
  families    WatchFamily[]
  calibres    Calibre[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("brands")
}

model WatchFamily {
  id          String           @id @default(cuid())
  brandId     String
  brand       Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  slug        String           @unique
  description Json?            // { es: "...", en: "..." }
  imageUrl    String?
  references  WatchReference[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("watch_families")
}

model WatchReference {
  id              String           @id @default(cuid())
  familyId        String
  family          WatchFamily      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  reference       String           // "126610LN"
  name            String           // "Submariner Date"
  nameEs          String?          // "Submariner Fecha"
  year            Int?
  discontinued    Boolean          @default(false)
  limited         Boolean          @default(false)
  limitedQuantity Int?

  // Pricing
  retailPriceEur  Float?
  retailPriceUsd  Float?

  // Case specs
  caseDiameter    Float?           // mm
  caseThickness   Float?           // mm
  lugWidth        Float?           // mm
  caseMaterial    String?
  bezelMaterial   String?
  bezelType       String?
  crystalType     String?          // "Sapphire", "Mineral"
  waterResistance Int?             // metres
  crownType       String?

  // Dial specs
  dialColor       String?
  dialMaterial    String?
  indexType       String?

  // Movement
  calibreId       String?
  calibre         Calibre?         @relation(fields: [calibreId], references: [id])
  movementType    MovementType     @default(AUTOMATIC)

  // Strap/Bracelet
  strapMaterial   String?
  strapColor      String?
  claspType       String?

  // Relations
  images          WatchImage[]
  priceHistory    PricePoint[]
  variants        WatchVariant[]
  reviews         Review[]
  collections     CollectionItem[]
  wishlists       WishlistItem[]
  complications   Complication[]
  tags            Tag[]            @relation("WatchTags")

  // SEO & search
  slug            String           @unique
  description     Json?            // { es: "...", en: "..." }
  searchIndex     String?          @db.Text // Flattened text for MeiliSearch

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("watch_references")
}

model WatchVariant {
  id            String         @id @default(cuid())
  watchId       String
  watch         WatchReference @relation(fields: [watchId], references: [id], onDelete: Cascade)
  name          String
  dialColor     String?
  strapMaterial String?
  strapColor    String?
  imageUrl      String?
  retailPriceEur Float?

  @@map("watch_variants")
}

model WatchImage {
  id        String         @id @default(cuid())
  watchId   String
  watch     WatchReference @relation(fields: [watchId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean        @default(false)
  order     Int            @default(0)

  @@map("watch_images")
}

// ─────────────────────────────────────────────────
// CALIBRES / MOVEMENTS
// ─────────────────────────────────────────────────

model Calibre {
  id            String           @id @default(cuid())
  brandId       String
  brand         Brand            @relation(fields: [brandId], references: [id])
  name          String           // "Cal. 3235"
  type          MovementType     @default(AUTOMATIC)
  frequency     Int?             // vph e.g. 28800
  powerReserve  Int?             // hours
  jewels        Int?
  diameter      Float?           // mm
  thickness     Float?           // mm
  components    Int?
  cosc          Boolean          @default(false)
  certified     String?          // "COSC Chronometer", "Geneva Seal"
  features      String[]         // ["stop-seconds", "quick-set date"]
  watches       WatchReference[]
  createdAt     DateTime         @default(now())

  @@map("calibres")
}

// ─────────────────────────────────────────────────
// PRICES
// ─────────────────────────────────────────────────

model PricePoint {
  id        String         @id @default(cuid())
  watchId   String
  watch     WatchReference @relation(fields: [watchId], references: [id], onDelete: Cascade)
  date      DateTime
  priceEur  Float
  priceUsd  Float?
  source    PriceSource    @default(MANUAL)
  condition WatchCondition @default(EXCELLENT)

  @@index([watchId, date])
  @@map("price_points")
}

// ─────────────────────────────────────────────────
// USERS & COLLECTIONS
// ─────────────────────────────────────────────────

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String?
  image         String?
  preferredLang Language         @default(ES)
  bio           String?
  collection    CollectionItem[]
  wishlist      WishlistItem[]
  reviews       Review[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model CollectionItem {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchId       String
  watch         WatchReference @relation(fields: [watchId], references: [id])
  purchasePrice Float?
  purchaseCurrency String?     @default("EUR")
  purchaseDate  DateTime?
  condition     WatchCondition @default(EXCELLENT)
  notes         String?
  isPublic      Boolean        @default(false)
  createdAt     DateTime       @default(now())

  @@unique([userId, watchId])
  @@map("collection_items")
}

model WishlistItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchId   String
  watch     WatchReference @relation(fields: [watchId], references: [id])
  notes     String?
  createdAt DateTime       @default(now())

  @@unique([userId, watchId])
  @@map("wishlist_items")
}

// ─────────────────────────────────────────────────
// REVIEWS & CONTENT
// ─────────────────────────────────────────────────

model Review {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchId   String
  watch     WatchReference @relation(fields: [watchId], references: [id])
  rating    Int            // 1-5
  title     String
  body      String         @db.Text
  lang      Language       @default(ES)
  pros      String[]
  cons      String[]
  helpful   Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("reviews")
}

// ─────────────────────────────────────────────────
// TAXONOMY
// ─────────────────────────────────────────────────

model Complication {
  id      String           @id @default(cuid())
  nameEs  String           @unique // "Tourbillón"
  nameEn  String           @unique // "Tourbillon"
  slug    String           @unique
  watches WatchReference[]

  @@map("complications")
}

model Tag {
  id      String           @id @default(cuid())
  name    String           @unique
  watches WatchReference[] @relation("WatchTags")

  @@map("tags")
}

// ─────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────

enum MovementType {
  AUTOMATIC
  MANUAL
  QUARTZ
  SOLAR
  KINETIC
  SMARTWATCH
}

enum WatchCondition {
  NEW
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
}

enum PriceSource {
  MANUAL
  WATCHBASE
  THEWATCHAPI
  CHRONO24_AVG
  AUCTION
}

enum Language {
  ES
  EN
}
